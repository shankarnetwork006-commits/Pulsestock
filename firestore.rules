rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   match /dailyStats/{doc} { allow read: if true; allow write: if false; }
   match /dailyVotes/{doc} { allow read, write: if false; }
   match /dailyViews/{doc} { allow read, write: if false; }
   match /{document=**} { allow read, write: if false; }
 }
}